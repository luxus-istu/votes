CREATE TABLE UserTable (
    email TEXT NOT NULL PRIMARY KEY,
    password TEXT NOT NULL,
    firstName TEXT NOT NULL,
    lastName TEXT NOT NULL,
    gender TEXT NOT NULL,
    isCurrent INTEGER NOT NULL DEFAULT 0
);

getUserByEmail:
SELECT * FROM UserTable WHERE email = ?;

getCurrentUser:
SELECT * FROM UserTable WHERE isCurrent = 1 LIMIT 1;

insertUser:
INSERT OR REPLACE INTO UserTable(email, password, firstName, lastName, gender, isCurrent)
VALUES (?, ?, ?, ?, ?, ?);

setCurrentUser:
UPDATE UserTable SET isCurrent = CASE WHEN email = ? THEN 1 ELSE 0 END;

clearCurrentUser:
UPDATE UserTable SET isCurrent = 0;

CREATE TABLE WordTable (
    id TEXT NOT NULL PRIMARY KEY,
    udmurt TEXT NOT NULL,
    transcription TEXT NOT NULL,
    russian TEXT NOT NULL,
    category TEXT NOT NULL,
    emoji TEXT NOT NULL
);

getAllWords:
SELECT * FROM WordTable;

insertWord:
INSERT OR REPLACE INTO WordTable(id, udmurt, transcription, russian, category, emoji)
VALUES (?, ?, ?, ?, ?, ?);

CREATE TABLE GameStatsTable (
    gameKey TEXT NOT NULL PRIMARY KEY,
    totalAnswered INTEGER NOT NULL DEFAULT 0,
    totalCorrect INTEGER NOT NULL DEFAULT 0
);

getStatsForGame:
SELECT * FROM GameStatsTable WHERE gameKey = ?;

getAllGameStats:
SELECT * FROM GameStatsTable;

insertOrUpdateStats:
INSERT OR REPLACE INTO GameStatsTable(gameKey, totalAnswered, totalCorrect)
VALUES (?, ?, ?);

CREATE TABLE LessonProgressTable (
    wordId TEXT NOT NULL PRIMARY KEY
);

getViewedWordIds:
SELECT wordId FROM LessonProgressTable;

markWordViewed:
INSERT OR IGNORE INTO LessonProgressTable(wordId) VALUES (?);

CREATE TABLE SettingsTable (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    soundEnabled INTEGER NOT NULL DEFAULT 1,
    notificationsEnabled INTEGER NOT NULL DEFAULT 1,
    geolocationEnabled INTEGER NOT NULL DEFAULT 0
);

getSettings:
SELECT * FROM SettingsTable WHERE id = 1;

insertOrUpdateSettings:
INSERT OR REPLACE INTO SettingsTable(id, soundEnabled, notificationsEnabled, geolocationEnabled)
VALUES (1, ?, ?, ?);
